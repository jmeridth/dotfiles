#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

UBUNTU_NO_KEY_UPDATE=false
for arg in "$@"; do
  case "$arg" in
    ubuntu-no-key-update) UBUNTU_NO_KEY_UPDATE=true ;;
    *)
      echo "Unknown option: $arg" >&2
      echo "Usage: $0 [ubuntu-no-key-update]" >&2
      exit 1
      ;;
  esac
done

echo "=== Dotfiles Setup ==="
echo ""

# Link dotfiles first
"$SCRIPT_DIR/scripts/link-dotfiles.sh"
echo ""

# Install packages
"$SCRIPT_DIR/scripts/install-packages.sh"
echo ""

# Install additional tools
if [[ "$UBUNTU_NO_KEY_UPDATE" == true ]]; then
  "$SCRIPT_DIR/scripts/install-tools.sh" ubuntu-no-key-update
else
  "$SCRIPT_DIR/scripts/install-tools.sh"
fi
echo ""

# Install Claude Code marketplaces and plugins
"$SCRIPT_DIR/scripts/install-claude-plugins.sh"
echo ""

echo "=== Setup complete ==="
echo ""
echo "Reload your shell to pick up the new config:"
echo "  source ~/.zshrc"
