#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "=== Dotfiles Setup ==="
echo ""

# Link dotfiles first
"$SCRIPT_DIR/scripts/link-dotfiles.sh"
echo ""

# Install packages
"$SCRIPT_DIR/scripts/install-packages.sh"
echo ""

# Install additional tools
"$SCRIPT_DIR/scripts/install-tools.sh"
echo ""

# Install Claude Code marketplaces and plugins
"$SCRIPT_DIR/scripts/install-claude-plugins.sh"
echo ""

echo "=== Setup complete ==="
echo ""
if [[ "$(basename "$SHELL")" == "zsh" ]]; then
  echo "Reload your shell to pick up the new config:"
  echo "  source ~/.zshrc"
else
  echo "Your login shell is $(basename "$SHELL"), and ~/.zshrc only loads in zsh."
  echo "Start zsh now:"
  echo "  zsh"
  echo "Make zsh your login shell (log out and back in afterwards):"
  echo "  chsh -s \"\$(command -v zsh)\""
fi
